# Modelo de variáveis de ambiente. COPIE para `.env.local` e preencha lá.
# NÃO coloque segredos reais neste arquivo — ele é versionado no git.

# Supabase — URL e chave pública (podem ir para o cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — chave de service role. NUNCA exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Área administrativa
ADMIN_PASSWORD=
# Segredo usado para assinar o cookie de sessão do admin (string longa e aleatória)
ADMIN_SESSION_SECRET=

# URL pública do site (ex.: https://cha-revelacao.onrender.com) — usada nos metadados Open Graph
NEXT_PUBLIC_SITE_URL=
