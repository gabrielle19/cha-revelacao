# Modelo de variáveis de ambiente. COPIE para `.env.local` e preencha lá.
# NÃO coloque segredos reais neste arquivo — ele é versionado no git.
#
# O site é 100% estático: todas as variáveis são públicas (NEXT_PUBLIC_*),
# e é normal (e esperado) que a chave anon apareça no código do navegador.
# A segurança fica a cargo das regras (RLS) do banco.

# Supabase — URL e chave pública (anon)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (ex.: https://cha-revelacao.onrender.com) — usada nos metadados Open Graph
NEXT_PUBLIC_SITE_URL=
